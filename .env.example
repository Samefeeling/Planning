# ---------------------------------------------------------------------------
# Resero Planning — environment configuration
# Copy to `.env.local` and fill in. All client-exposed vars MUST be VITE_*.
# ---------------------------------------------------------------------------

# Which data source the app loads on startup:
#   "mock"         : bundled seed.json (no network, instant demo)
#   "planning-csv" : Planning1.csv for orders + the ASSY_Operator list for people
#   "excel"        : the full PMD master workbook (adds inventory / BOM / POs)
VITE_DATA_SOURCE=mock

# --- Planning1.csv (only when VITE_DATA_SOURCE=planning-csv) -----------------
# Serve the export over plain HTTP and point at it here...
VITE_PLANNING_CSV_URL=
# ...or leave that blank and read it from the SharePoint drive below.
VITE_PLANNING_CSV_PATH=/Shared Documents/Planning1.csv

# --- JobMaterialReq.csv (optional; the order-to-order dependency chain) ------
# One row per component of an order: JobMtl_JobNum builds JobHead_PartNum out
# of JobMtl_PartNum. Wherever another open order is still making one of those
# components, the parent waits for it. Leave both blank and every order simply
# schedules on its own.
VITE_JOB_MATERIAL_CSV_URL=
VITE_JOB_MATERIAL_CSV_PATH=/Shared Documents/JobMaterialReq.csv

# Either way, the "Load CSV" button in the header parses files picked by hand —
# select both exports at once — which is the quickest way to check them against
# the board.

# --- SharePoint / Microsoft Graph -------------------------------------------
# Needed for VITE_DATA_SOURCE=excel, and for planning-csv to read the
# ASSY_Operator roster list (and the CSV, when no URL is set above).
# Site that hosts the workbook, e.g. https://contoso.sharepoint.com/sites/PMD
VITE_SHAREPOINT_SITE_URL=
# Server-relative or Graph drive path to the workbook
VITE_SHAREPOINT_FILE_PATH=/Shared Documents/PMD_Schedule_master_epicor.xlsm
# A pre-fetched Graph access token (dev only). In production use a token broker.
VITE_GRAPH_TOKEN=

# --- Plan persistence (single planner; stored server-side) ---
# REST endpoint implementing GET/PUT /plans (see persistence/ApiPlanRepository).
# PUT requests identify ASSY_Production in X-Production-List. The service should
# upsert assembly.production entries into that SharePoint list by Job + Date.
# Leave blank to fall back to browser localStorage.
VITE_PERSIST_API_URL=

# How often (minutes) to auto-refresh source data. Every 5 minutes by default,
# so a re-exported Planning1.csv reaches the board on its own. A refresh keeps
# every placement and crew allocation the planner has made.
VITE_REFRESH_INTERVAL_MINUTES=5

# --- Plan write-back to SharePoint ------------------------------------------
# Name the list to mirror the board into, one row per order per day. LEAVE
# BLANK TO DISABLE: nothing is written unless this is set and Graph is
# configured above.
#
# This is the list Resero already designed, mirroring PMD_Production. It needs
# these internal column names:
#   key         Title (text, the job number) · Date (date)
#   order-level Line · Operators · OperatorIds (text)
#               StartDate · DueDate · ExpectDate (date+time)
#               OrderQty · RemainingQty (number)
#   row-level   ShiftOutput · Complete · Reject · Rework (number)
#               JobCompleted · Paused (yes/no) · PauseReason · Notes (text)
#
# Which side owns which column:
#   Planning1.csv  ->  DueDate, OrderQty, RemainingQty
#   the supervisor ->  Operators, OperatorIds, StartDate, Line
#   the shift      ->  everything row-level
# So dragging a bar writes StartDate only; Epicor's Due Date is never changed
# from this board, including when a bar is moved onto an approved weekend. Order-level columns are kept in step on every row of a job,
# so a re-exported Due Date reaches rows booked weeks ago.
VITE_PRODUCTION_LIST=

# Password the supervisor types before allocating crew or approving weekend
# overtime. Blank disables the gate entirely, which is what the mock demo and a
# fresh checkout run with. Booking shift output is never gated.
#
# NOT A SECURITY BOUNDARY. Every VITE_* variable is compiled into the
# JavaScript bundle, so anyone with dev tools can read this. It stops the board
# being changed by whoever is standing at the terminal; it does not protect the
# SharePoint list (the Graph token and the list permissions do that). Do not
# reuse a password that matters anywhere else.
VITE_SUPERVISOR_PASSWORD=
