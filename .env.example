# ---------------------------------------------------------------------------
# Resero Planning — environment configuration
# Copy to `.env.local` and fill in. All client-exposed vars MUST be VITE_*.
# ---------------------------------------------------------------------------

# Which data source the app loads on startup:
#   "mock"         : bundled seed.json (no network, instant demo)
#   "planning-csv" : Planning1.csv for orders + the ASSY_Operator list for people
#   "excel"        : the full PMD master workbook (adds inventory / BOM / POs)
VITE_DATA_SOURCE=mock

# --- Planning1.csv (only when VITE_DATA_SOURCE=planning-csv) -----------------
# Serve the export over plain HTTP and point at it here...
VITE_PLANNING_CSV_URL=
# ...or leave that blank and read it from the SharePoint drive below.
VITE_PLANNING_CSV_PATH=/Shared Documents/Planning1.csv
# Either way, the "Load CSV" button in the header parses a file picked by hand,
# which is the quickest way to check an export against the board.

# --- SharePoint / Microsoft Graph -------------------------------------------
# Needed for VITE_DATA_SOURCE=excel, and for planning-csv to read the
# ASSY_Operator roster list (and the CSV, when no URL is set above).
# Site that hosts the workbook, e.g. https://contoso.sharepoint.com/sites/PMD
VITE_SHAREPOINT_SITE_URL=
# Server-relative or Graph drive path to the workbook
VITE_SHAREPOINT_FILE_PATH=/Shared Documents/PMD_Schedule_master_epicor.xlsm
# A pre-fetched Graph access token (dev only). In production use a token broker.
VITE_GRAPH_TOKEN=

# --- Plan persistence (single planner; stored server-side) ---
# REST endpoint implementing GET/PUT /plans (see persistence/ApiPlanRepository).
# PUT requests identify ASSY_Production in X-Production-List. The service should
# upsert assembly.production entries into that SharePoint list by Job + Date.
# Leave blank to fall back to browser localStorage.
VITE_PERSIST_API_URL=

# How often (minutes) to auto-refresh source data. Every 5 minutes by default,
# so a re-exported Planning1.csv reaches the board on its own. A refresh keeps
# every placement and crew allocation the planner has made.
VITE_REFRESH_INTERVAL_MINUTES=5

# --- Plan write-back to SharePoint ------------------------------------------
# Name the list to mirror the plan into, one row per order. LEAVE BLANK TO
# DISABLE: nothing is written unless this is set and Graph is configured above.
#
# Create the list with these exact internal column names:
#   Title (text, the job number) · Line (text) · Operators (text)
#   OperatorIds (text) · StartDate (date+time) · DueDate (date+time)
#   ExpectDate (date+time) · OrderQty (number) · RemainingQty (number)
#
# Which side owns which column:
#   Planning1.csv →  DueDate, OrderQty, RemainingQty
#   the planner   →  Operators, OperatorIds, StartDate, Line
# So dragging a bar writes StartDate only; Epicor's Due Date is never changed
# from this board.
VITE_PLAN_LIST=
